{
  "name": "actl",
  "version": "0.2.3",
  "description": "Actl Windows desktop harness",
  "author": "Actl",
  "private": true,
  "type": "module",
  "main": "./out/main/index.cjs",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "pnpm build:fixtures && electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "build:fixtures": "esbuild tests/electron/fixtures/mcp-server.ts --bundle --platform=node --target=node24 --format=cjs --outfile=out/fixtures/mcp-server.cjs",
    "build": "pnpm typecheck && pnpm build:fixtures && electron-vite build",
    "start": "electron-vite preview",
    "start:packaged": "node scripts/start-packaged.mjs",
    "diagnose:renderer": "electron scripts/diagnose-renderer.cjs",
    "pack:dir": "pnpm build && electron-builder --win --x64 --dir",
    "pack:win": "pnpm build && electron-builder --win nsis --x64",
    "verify:agent": "pnpm build && node scripts/verify-agent.mjs",
    "verify:agent:packaged": "node scripts/verify-agent.mjs --packaged",
    "test:agent-ui": "node --import tsx --test tests/unit/agent/useAgent.test.ts tests/unit/agent/desktopTransport.test.ts tests/unit/i18n/catalog.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@mozilla/readability": "^0.6.0",
    "iconv-lite": "0.7.3",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^31.0.0",
    "koffi": "3.3.7",
    "openai": "6.45.0",
    "pino": "10.3.1",
    "pino-roll": "4.0.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^8.12.4",
    "yaml": "2.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@floating-ui/vue": "1.1.11",
    "@guolao/vue-monaco-editor": "1.6.0",
    "@iconify/vue": "5.0.0",
    "@lucide/vue": "1.22.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@noble/hashes": "2.2.0",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.2.2",
    "@tiptap/extension-image": "3.22.4",
    "@tiptap/extension-link": "3.22.4",
    "@tiptap/extension-placeholder": "3.22.4",
    "@tiptap/extension-youtube": "3.22.4",
    "@tiptap/starter-kit": "3.22.4",
    "@tiptap/vue-3": "3.22.4",
    "@types/jsdom": "^30.0.0",
    "@types/katex": "0.16.8",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.19.2",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vueuse/core": "14.2.1",
    "electron": "43.8.7",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "floating-vue": "5.2.2",
    "highlight.js": "11.11.1",
    "jszip": "3.10.1",
    "katex": "0.16.40",
    "markdown-it": "14.1.1",
    "markdown-it-link-attributes": "4.0.1",
    "markdown-it-texmath": "1.0.0",
    "monaco-editor": "0.55.1",
    "motion-v": "2.2.1",
    "pinia": "3.0.4",
    "swiper": "12.1.3",
    "tailwindcss": "4.2.2",
    "tsx": "4.22.4",
    "tus-js-client": "4.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vue": "3.5.45",
    "vue-i18n": "11.4.12",
    "vue-router": "5.0.4",
    "vue-tsc": "3.3.14"
  }
}
