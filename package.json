{
  "name": "actl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier src --write",
    "format:check": "prettier src --check",
    "preview": "vite preview",
    "test": "vitest run",
    "agent:dev": "pnpm --dir agent dev",
    "agent:build": "pnpm --dir agent build",
    "agent:typecheck": "pnpm --dir agent typecheck",
    "agent:test": "pnpm --dir agent test",
    "agent:package:tauri": "pnpm --dir agent package:tauri && node scripts/prepare-tauri-agent.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "packageManager": "pnpm@12.3.4",
  "dependencies": {
    "@floating-ui/vue": "^1.1.11",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@lucide/vue": "^1.22.0",
    "@noble/hashes": "^2.2.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "~2.12.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/extension-image": "^3.22.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/extension-youtube": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "@tiptap/vue-3": "^3.22.4",
    "@types/katex": "^0.16.8",
    "@vueuse/core": "^14.2.1",
    "floating-vue": "^5.2.2",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.40",
    "markdown-it": "^14.1.1",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-texmath": "^1.0.0",
    "monaco-editor": "^0.55.1",
    "motion-v": "^2.2.1",
    "pinia": "^3.0.4",
    "swiper": "^12.1.3",
    "tailwindcss": "^4.2.2",
    "tus-js-client": "^4.3.1",
    "vue": "^3.5.30",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify/vue": "^5.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/cli": "~2.12.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.2.5"
  }
}
