# Agent local data and HTTP server
ACTL_AGENT_HOME=./.runtime
ACTL_AGENT_PORT=3000
ACTL_AGENT_RUNTIME_MODE=development

# Must match VITE_ACTL_AGENT_LOCAL_TOKEN in the frontend environment file.
ACTL_AGENT_LOCAL_TOKEN=replace-with-a-long-random-local-token

# Optional
# ACTL_AGENT_LOG_LEVEL=debug
# ACTL_AGENT_LOG_DIR=./.runtime/logs
# ACTL_AGENT_BROWSER_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
